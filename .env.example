# --- Nextcloud -----------------------------------------------------------
# Base URL of your Nextcloud instance (no trailing slash)
NEXTCLOUD_URL=https://cloud.example.com

# Secret given to `occ talk:bot:install <name> <secret> <url> ...` (40-128
# chars). Verifies the incoming webhooks (HMAC-SHA256 signature headers)
# and signs outgoing calls to the Talk bot API.
TALK_BOT_SECRET=please-generate-64-random-chars-here

# --- optional legacy fallback (classic bot payload only) ------------------
# Needed only if your Nextcloud sends the OLD bot payload
# ({token, room_id, message}) without signature headers.
BOT_USER=
BOT_APP_PASSWORD=

# --- behaviour -------------------------------------------------------------
# python logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Kill a pi run after this many seconds (heartbeat enforces it)
PI_TIMEOUT=600
# Seconds between heartbeat task checks
HEARTBEAT_INTERVAL=30
# Retries after a failed/timed-out run (restarted with pi --continue)
MAX_RETRIES=1

# NOTE: pi itself is configured with its default config files
# (auth.json / models.json in the pi-home volume) — see docs/docker.md.
