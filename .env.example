# --- Nextcloud -----------------------------------------------------------
# Base URL of your Nextcloud instance (no trailing slash)
NEXTCLOUD_URL=https://cloud.example.com

# ONE token: Nextcloud sends it in the webhook payload and pigeon uses it
# as bearer token for the Talk API. Must be the token passed to
# `occ talk:bot:install`.
NEXTCLOUD_BOT_TOKEN=change-me

# --- behaviour -------------------------------------------------------------
# python logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Kill a pi run after this many seconds (heartbeat enforces it)
PI_TIMEOUT=600
# Seconds between heartbeat task checks
HEARTBEAT_INTERVAL=30
# Retries after a failed/timed-out run (restarted with pi --continue)
MAX_RETRIES=1

# NOTE: pi itself is configured with its default config files
# (auth.json / models.json in the pi-home volume) — see docs/docker.md.
